# Copy to .env and fill in for your environment. Defaults are safe for a
# local TWS/IB Gateway PAPER-trading session.

ENV=paper
LOG_LEVEL=INFO
LOG_JSON=true

# --- IBKR connection ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
IBKR_READ_ONLY=true

# --- Risk limits ---
RISK_MAX_DAILY_DRAWDOWN_PCT=2.0
RISK_MAX_POSITION_NOTIONAL_USD=250000
# Contracts/symbol limits are counted in "lots" (exchange step-size units),
# not whole coins — a normal $50-100 crypto order can easily be 10,000+
# lots on a cheap coin. 20/50 (fine for whole futures contracts like ES)
# will silently reject every real crypto order as a "fat finger." Left
# effectively unbounded here; the real per-trade size control is
# SCANNER_ORDER_NOTIONAL_USDT (config/settings.py), not this.
RISK_MAX_CONTRACTS_PER_ORDER=100000000
RISK_MAX_CONTRACTS_PER_SYMBOL=100000000
RISK_MAX_ORDERS_PER_SECOND=5
RISK_MAX_ORDERS_PER_MINUTE=60
RISK_TARGET_ANNUAL_VOLATILITY_PCT=12.0
RISK_KELLY_FRACTION_CAP=0.5
RISK_MAX_GROSS_LEVERAGE=4.0

# --- Data / storage ---
DATA_DUCKDB_PATH=./data_store/market_data.duckdb
DATA_REDIS_URL=redis://localhost:6379/0

# --- Binance Futures ---
# NEVER put your real API key/secret in this file or any file you commit.
# This .env.example is a TEMPLATE only — copy it to a real ".env" file,
# which is already excluded via .gitignore and must stay that way.
#
# Create your key at https://testnet.binancefuture.com (practice funds) or,
# only once you are ready to go live, https://www.binance.com/en/my/settings/api-management
# with: Enable Futures = ON, Enable Withdrawals = OFF, IP-restricted to your
# server's address only.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# --- Funding-momentum scanner ---
# Defaults live in config/settings.py (ScannerStrategySettings) and are fine
# as-is; override any of them here with a SCANNER_ prefix if you want to,
# e.g. SCANNER_PRICE_JUMP_PCT=10.0
#
# Phase 1 Option C (final) — backtested Mar–Oct 2026. Uncomment all to use:
# SCANNER_TRADE_DIRECTION=follow        # pump -> LONG, dump -> SHORT ("fade" reverses)
# SCANNER_PRICE_JUMP_PCT=10
# SCANNER_PRICE_JUMP_WINDOW_MIN=20
# SCANNER_FUNDING_TREND_WINDOW_MIN=20
# SCANNER_LEVERAGE=3                    # 10% stop must sit well inside liquidation
# SCANNER_NOTIONAL_USDT=100             # trade size in USDT notional
# SCANNER_LADDER_ENABLED=true           # -10% stop, then 20 points behind the peak from +15%
# SCANNER_STOP_LOSS_PCT=10
# SCANNER_MAX_HOLD_HOURS=72             # close after 3 days
# SCANNER_MAX_OPEN_POSITIONS=6          # hard cap
# SCANNER_MAX_YOUNG_POSITIONS=4         # max open positions younger than 24 h
# SCANNER_REENTRY_PAUSE_S=120           # 2-min pause before re-entering the same coin
# SCANNER_MAX_DAILY_LOSS_USDT=200       # halt new entries at -200 USDT from the day's start

# --- Telegram alerts (optional) ---
# Leave TELEGRAM_BOT_TOKEN blank to disable — nothing else changes.
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts —
#    it gives you a bot token (looks like 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx).
# 2. Send any message to your new bot (search its username, hit Start).
# 3. Visit https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser
#    and find "chat":{"id": ...} in the response — that number is your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- BINBOT2: ATR volatility breakout (scripts/run_live_binbot2_atr.py) ---
# Leverage / margin type / max open positions still come from SCANNER_*.
# Defaults live in config/binbot2_settings.py.
# ATR_ORDER_NOTIONAL_USDT=250
# ATR_STOP_LOSS_PCT=2          # % of notional; 0 = use ATR_STOP_LOSS_USDT
# ATR_STOP_LOSS_USDT=5
# ATR_TAKE_PROFIT_USDT=10
# ATR_TAKE_PROFIT_PCT=4         # % of notional; 0 = use ATR_TAKE_PROFIT_USDT (ignored while ladder is on)
# Profit ladder (% of notional): BE at +4%, +4% lock at +8%, +1% per further +2%
# ATR_LADDER_ENABLED=false       # true = profit ladder instead of fixed TP
# ATR_BREAKEVEN_TRIGGER_PCT=4
# ATR_BREAKEVEN_LOCK_PCT=0
# ATR_TRAIL_START_PCT=8
# ATR_TRAIL_START_LOCK_PCT=4
# ATR_TRAIL_STEP_PCT=2
# ATR_TRAIL_STEP_LOCK_PCT=1
# ATR_MAX_DAILY_LOSS_USDT=100    # 0 = use RISK_MAX_DAILY_DRAWDOWN_PCT instead
# ATR_CANDLE_INTERVAL=5m
# ATR_ATR_PERIOD=14
# ATR_MEAN_PERIOD=20
# ATR_ATR_MULTIPLIER=2.0
# ATR_MIN_CANDLE_QUOTE_VOLUME_USDT=100000
# ATR_MIN_VOLUME_MULTIPLE=2.0
# ATR_MIN_CLOSE_POSITION=0.7
# ATR_SYMBOL_COOLDOWN_MIN=60
# ATR_ALLOW_LONG=true
# ATR_ALLOW_SHORT=true
# ATR_MAX_REQUESTS_PER_S=40
# ATR_DASHBOARD_PORT=8766
